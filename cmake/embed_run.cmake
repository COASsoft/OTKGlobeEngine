file(READ "${IN}" hex HEX)
string(LENGTH "${hex}" n)
math(EXPR size "${n} / 2")
if(MODE STREQUAL "STRING")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "\\\\x\\1" body "${hex}")
    string(REGEX REPLACE "((\\\\x[0-9a-f][0-9a-f]){64})" "\\1\"\n\"" body "${body}")
    file(WRITE "${OUT}" "#include <cstddef>\nnamespace otk::embedded {\nextern const unsigned char ${SYMBOL}[] =\n\"${body}\";\nextern const std::size_t ${SYMBOL}_size = ${size};\n}\n")
else()
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," body "${hex}")
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n" body "${body}")
    file(WRITE "${OUT}" "#include <cstddef>\nnamespace otk::embedded {\nextern const unsigned char ${SYMBOL}[] = {\n${body}\n};\nextern const std::size_t ${SYMBOL}_size = ${size};\n}\n")
endif()
