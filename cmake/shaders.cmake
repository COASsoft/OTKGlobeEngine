set(OTE_SHDC_COMMIT b975d5642093d62e76a1e088bdae945d6d8b8ff2)
set(OTE_PREGENERATED_SHADER_LANGS glsl410)

set(_shdc_dir "")
if(CMAKE_HOST_WIN32)
    set(_shdc_dir win32)
    set(_shdc_name sokol-shdc.exe)
elseif(CMAKE_HOST_APPLE)
    if(CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "arm64|aarch64")
        set(_shdc_dir osx_arm64)
    else()
        set(_shdc_dir osx)
    endif()
    set(_shdc_name sokol-shdc)
elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    if(CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "arm64|aarch64")
        set(_shdc_dir linux_arm64)
    else()
        set(_shdc_dir linux)
    endif()
    set(_shdc_name sokol-shdc)
endif()

set(_pregenerated_default OFF)
if(NOT _shdc_dir)
    set(_pregenerated_default ON)
endif()
option(OTE_PREGENERATED_SHADERS "Use the shader headers in src/render/shaders/generated instead of running sokol-shdc" ${_pregenerated_default})

set(OTE_SHDC "")
if(_shdc_dir)
    set(OTE_SHDC "${CMAKE_BINARY_DIR}/tools/${_shdc_name}")
    if(NOT EXISTS "${OTE_SHDC}")
        file(DOWNLOAD
            "https://raw.githubusercontent.com/floooh/sokol-tools-bin/${OTE_SHDC_COMMIT}/bin/${_shdc_dir}/${_shdc_name}"
            "${OTE_SHDC}" STATUS _shdc_status TLS_VERIFY ON)
        list(GET _shdc_status 0 _shdc_code)
        if(NOT _shdc_code EQUAL 0)
            if(OTE_PREGENERATED_SHADERS)
                set(OTE_SHDC "")
            else()
                message(FATAL_ERROR "Downloading sokol-shdc failed: ${_shdc_status}")
            endif()
        elseif(NOT CMAKE_HOST_WIN32)
            file(CHMOD "${OTE_SHDC}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
        endif()
    endif()
endif()

function(ote_add_shaders target)
    if(OTE_PREGENERATED_SHADERS)
        set(dir "${PROJECT_SOURCE_DIR}/src/render/shaders/generated/${OTE_SHDC_LANG}")
        foreach(src IN LISTS ARGN)
            get_filename_component(name "${src}" NAME_WE)
            if(NOT EXISTS "${dir}/${name}.glsl.h")
                message(FATAL_ERROR "No pregenerated ${OTE_SHDC_LANG} header for ${name}; pregenerated languages: ${OTE_PREGENERATED_SHADER_LANGS}")
            endif()
        endforeach()
        target_include_directories(${target} PRIVATE "${dir}")
    else()
        set(out_dir "${CMAKE_CURRENT_BINARY_DIR}/shaders")
        file(MAKE_DIRECTORY "${out_dir}")
        set(outputs)
        foreach(src IN LISTS ARGN)
            get_filename_component(abs "${src}" ABSOLUTE)
            get_filename_component(name "${src}" NAME_WE)
            set(out "${out_dir}/${name}.glsl.h")
            add_custom_command(
                OUTPUT "${out}"
                COMMAND "${OTE_SHDC}" --input "${abs}" --output "${out}" --slang "${OTE_SHDC_LANG}" --format sokol
                DEPENDS "${abs}"
                COMMENT "sokol-shdc ${name}"
                VERBATIM)
            list(APPEND outputs "${out}")
        endforeach()
        target_sources(${target} PRIVATE ${outputs})
        target_include_directories(${target} PRIVATE "${out_dir}")
    endif()
    if(OTE_SHDC AND NOT TARGET ote_pregenerate_shaders)
        set(commands)
        foreach(lang IN LISTS OTE_PREGENERATED_SHADER_LANGS)
            list(APPEND commands COMMAND "${CMAKE_COMMAND}" -E make_directory "src/render/shaders/generated/${lang}")
            foreach(src IN LISTS ARGN)
                get_filename_component(abs "${src}" ABSOLUTE)
                file(RELATIVE_PATH rel "${PROJECT_SOURCE_DIR}" "${abs}")
                get_filename_component(name "${src}" NAME_WE)
                list(APPEND commands COMMAND "${OTE_SHDC}" --input "${rel}" --output "src/render/shaders/generated/${lang}/${name}.glsl.h"
                     --slang "${lang}" --format sokol)
            endforeach()
        endforeach()
        add_custom_target(ote_pregenerate_shaders ${commands} WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}" VERBATIM)
    endif()
endfunction()
