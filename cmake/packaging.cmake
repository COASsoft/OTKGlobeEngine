include(GNUInstallDirs)
include(CMakePackageConfigHelpers)

set(OTK_PACKAGE_SYSTEM "" CACHE STRING "Platform suffix used in package file names, for example linux-x86_64")
if(NOT OTK_PACKAGE_SYSTEM)
    string(TOLOWER "${CMAKE_SYSTEM_NAME}" _otk_sys)
    if(_otk_sys STREQUAL "darwin")
        set(_otk_sys macos)
    endif()
    string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" _otk_arch)
    if(_otk_arch MATCHES "^(amd64|x86_64|x64)$")
        set(_otk_arch x86_64)
    elseif(_otk_arch MATCHES "^(aarch64|arm64)$")
        set(_otk_arch arm64)
    endif()
    if(APPLE AND CMAKE_OSX_ARCHITECTURES MATCHES ";")
        set(_otk_arch universal)
    endif()
    if(OTK_GLES)
        set(_otk_arch "${_otk_arch}-gles")
    endif()
    set(OTK_PACKAGE_SYSTEM "${_otk_sys}-${_otk_arch}")
endif()

set_target_properties(otkglobeengine_c PROPERTIES VERSION ${PROJECT_VERSION} SOVERSION ${PROJECT_VERSION_MAJOR})
target_include_directories(otkglobeengine_c INTERFACE $<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/include> $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>)
target_compile_definitions(otkglobeengine_c INTERFACE OTK_SHARED)

