install(FILES ${CMAKE_BINARY_DIR}/OTKGlobeEngineConfig.cmake ${CMAKE_BINARY_DIR}/OTKGlobeEngineConfigVersion.cmake
    DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/OTKGlobeEngine)
