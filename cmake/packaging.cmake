include(GNUInstallDirs)
include(CMakePackageConfigHelpers)

set(OTE_PACKAGE_SYSTEM "" CACHE STRING "Platform suffix used in package file names, for example linux-x86_64")
if(NOT OTE_PACKAGE_SYSTEM)
    string(TOLOWER "${CMAKE_SYSTEM_NAME}" _ote_sys)
    if(_ote_sys STREQUAL "darwin")
        set(_ote_sys macos)
    endif()
    string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" _ote_arch)
    if(_ote_arch MATCHES "^(amd64|x86_64|x64)$")
        set(_ote_arch x86_64)
    elseif(_ote_arch MATCHES "^(aarch64|arm64)$")
        set(_ote_arch arm64)
    endif()
    if(APPLE AND CMAKE_OSX_ARCHITECTURES MATCHES ";")
        set(_ote_arch universal)
    endif()
    set(OTE_PACKAGE_SYSTEM "${_ote_sys}-${_ote_arch}")
endif()

set_target_properties(opentakengine_c PROPERTIES VERSION ${PROJECT_VERSION} SOVERSION ${PROJECT_VERSION_MAJOR})
target_include_directories(opentakengine_c INTERFACE $<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/include> $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>)
target_compile_definitions(opentakengine_c INTERFACE OTE_SHARED)

install(TARGETS opentakengine_c EXPORT OpenTAKEngineTargets
    RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
    LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
    ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR})
install(FILES ${PROJECT_SOURCE_DIR}/include/ote/ote.h DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/ote)
install(EXPORT OpenTAKEngineTargets NAMESPACE OpenTAKEngine:: DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/OpenTAKEngine)
configure_package_config_file(${PROJECT_SOURCE_DIR}/cmake/OpenTAKEngineConfig.cmake.in ${CMAKE_BINARY_DIR}/OpenTAKEngineConfig.cmake
    INSTALL_DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/OpenTAKEngine)
write_basic_package_version_file(${CMAKE_BINARY_DIR}/OpenTAKEngineConfigVersion.cmake COMPATIBILITY SameMinorVersion)
install(FILES ${CMAKE_BINARY_DIR}/OpenTAKEngineConfig.cmake ${CMAKE_BINARY_DIR}/OpenTAKEngineConfigVersion.cmake
    DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/OpenTAKEngine)
