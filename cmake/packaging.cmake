set(_ote_licenses ${CMAKE_BINARY_DIR}/licenses)
function(ote_license name file)
    if(EXISTS "${file}")
        install(FILES "${file}" DESTINATION ${CMAKE_INSTALL_DOCDIR}/licenses RENAME "${name}.txt")
    endif()
endfunction()
function(ote_license_url name url)
    set(dest "${_ote_licenses}/${name}.txt")
    if(NOT EXISTS "${dest}")
        file(DOWNLOAD "${url}" "${dest}.part" STATUS st TLS_VERIFY ON)
        list(GET st 0 code)
        if(code EQUAL 0)
            file(RENAME "${dest}.part" "${dest}")
        else()
            file(REMOVE "${dest}.part")
            message(WARNING "Could not download the ${name} license: ${st}")
        endif()
    endif()
    ote_license(${name} "${dest}")
endfunction()
