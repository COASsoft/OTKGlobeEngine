prefix=${pcfiledir}/../..
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: OTKGlobeEngine
Description: Cross-platform map engine for TAK-style applications (C ABI)
URL: https://github.com/grangedevgroup-code/OTKGlobeEngine
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lotkglobeengine_c
Cflags: -I${includedir} -DOTK_SHARED
