prefix=${pcfiledir}/../..
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: OpenTAKEngine
Description: Cross-platform map engine for TAK-style applications (C ABI)
URL: https://github.com/grangedevgroup-code/OpenTAKEngine
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lopentakengine_c
Cflags: -I${includedir} -DOTE_SHARED
